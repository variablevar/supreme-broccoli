# Customer authentication: email + password + optional Google Authenticator.
# Self-contained (no Clerk). Demo accounts use demo-pass-NNNN; new
# registrations can use any password >= 10 chars.
#
# Symmetric key used to encrypt TOTP secrets at rest. Falls back to
# SUPABASE_SERVICE_ROLE_KEY if unset; for production set this to a
# dedicated 32+ char random string.
CUSTOMER_TOTP_ENC_KEY=

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Admin secret for POST /api/fleet (fleet stats updates). Any long random string.
FLEET_ADMIN_SECRET=

# Public URL of the admin app (used in CORS / links from emails).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
