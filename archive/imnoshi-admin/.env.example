# Admin authentication: email + password + Google Authenticator (TOTP).
# Only addresses in ADMIN_EMAILS can sign in. Default seeded accounts
# (escanor@imnoshi.com, var@imnoshi.com) start with the shared initial
# password 'Imnoshi@2026' and are forced to set a new password + scan a
# Google Authenticator QR code on first login.
ADMIN_EMAILS=escanor@imnoshi.com,var@imnoshi.com

# Symmetric key used to encrypt TOTP secrets at rest. Falls back to
# SUPABASE_SERVICE_ROLE_KEY if unset; for production set this to a
# dedicated 32+ char random string.
ADMIN_TOTP_ENC_KEY=

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Admin secret for POST /api/fleet (fleet stats updates). Any long random string.
FLEET_ADMIN_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
